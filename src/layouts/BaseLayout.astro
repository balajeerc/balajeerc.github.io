---
import "../styles/global.css";
import { getCanonicalURL } from "../utils/seo";

export interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  noindex?: boolean;
  article?: {
    publishedTime?: string;
    tags?: string[];
  };
}

const {
  title,
  description = "Programmer. Blogger. Nice Guy.",
  image = "/images/profile_casual.jpg",
  type = "website",
  noindex = false,
  article,
} = Astro.props;

const siteTitle = "Balajee Ramachandran";
const siteUrl = new URL(Astro.site!.toString());
const canonicalURL = getCanonicalURL(Astro.url.pathname, siteUrl);
const ogImage = new URL(image, siteUrl);

const fullTitle = title === siteTitle ? title : `${title} — ${siteTitle}`;

const navLinks = [
  { href: "/", label: "Blog" },
  { href: "/about/", label: "About" },
  { href: "/resume/", label: "Resume" },
];

const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isCurrent = (href: string) =>
  href === "/"
    ? currentPath === "/" || currentPath.startsWith("/posts")
    : currentPath === href.replace(/\/+$/, "");
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      // Runs before first paint so the chosen theme never flashes.
      (function () {
        document.documentElement.classList.remove("no-js");
        try {
          var saved = localStorage.getItem("theme");
          if (saved === "light" || saved === "dark") {
            document.documentElement.dataset.theme = saved;
          }
        } catch (e) {
          // localStorage can throw when blocked; fall back to the system preference.
        }
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Primary Meta Tags -->
    <title>{fullTitle}</title>
    <meta name="title" content={fullTitle} />
    <meta name="description" content={description} />
    <meta name="author" content="Balajee Ramachandran" />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />
    <meta name="generator" content="Astro" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage.toString()} />
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:locale" content="en_US" />
    {article && article.publishedTime && (
      <meta property="article:published_time" content={article.publishedTime} />
    )}
    {article && article.tags && (
      <meta property="article:tag" content={article.tags.join(",")} />
    )}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.toString()} />

    <!-- Favicon -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/favicon.svg" />

    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/inter-latin-400-normal.woff2"
      crossorigin="anonymous"
    />

    <!-- Feeds -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Balajee Ramachandran"
      href="/rss.xml"
    />
    <link
      rel="alternate"
      type="application/atom+xml"
      title="Balajee Ramachandran"
      href="/feed.xml"
    />
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <span class="site-title">
          <a href="/">Balajee Ramachandran</a>
        </span>
        <div class="header-right">
          <nav class="site-nav">
            {navLinks.map(({ href, label }) => (
              <a href={href} aria-current={isCurrent(href) ? "page" : undefined}>
                {label}
              </a>
            ))}
          </nav>
          <button
            type="button"
            class="theme-toggle"
            id="theme-toggle"
            aria-label="Switch to dark theme"
            title="Switch to dark theme"
          >
            <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
              stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
            <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor"
              stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
            </svg>
          </button>
        </div>
      </div>
    </header>

    <main class="container">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        &copy; {new Date().getFullYear()} Balajee Ramachandran
      </div>
    </footer>

    <script is:inline>
      (function () {
        var root = document.documentElement;
        var button = document.getElementById("theme-toggle");
        if (!button) return;

        var systemDark = window.matchMedia("(prefers-color-scheme: dark)");

        function activeTheme() {
          return root.dataset.theme || (systemDark.matches ? "dark" : "light");
        }

        function syncLabel() {
          var next = activeTheme() === "dark" ? "light" : "dark";
          var label = "Switch to " + next + " theme";
          button.setAttribute("aria-label", label);
          button.setAttribute("title", label);
        }

        button.addEventListener("click", function () {
          var next = activeTheme() === "dark" ? "light" : "dark";
          root.dataset.theme = next;
          try {
            localStorage.setItem("theme", next);
          } catch (e) {
            // Persisting is best-effort; the toggle still works for this page.
          }
          syncLabel();
        });

        // Follow the system while the reader has not made an explicit choice.
        systemDark.addEventListener("change", syncLabel);

        syncLabel();
      })();
    </script>
  </body>
</html>