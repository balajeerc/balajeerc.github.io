---
import "../styles/global.css";
import { getCanonicalURL } from "../utils/seo";

export interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  noindex?: boolean;
  article?: {
    publishedTime?: string;
    tags?: string[];
  };
}

const {
  title,
  description = "Programmer. Blogger. Nice Guy.",
  image = "/images/profile_casual.jpg",
  type = "website",
  noindex = false,
  article,
} = Astro.props;

const siteTitle = "Balajee Ramachandran";
const siteUrl = new URL(Astro.site!.toString());
const canonicalURL = getCanonicalURL(Astro.url.pathname, siteUrl);
const ogImage = new URL(image, siteUrl);

const fullTitle = title === siteTitle ? title : `${title} — ${siteTitle}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Primary Meta Tags -->
    <title>{fullTitle}</title>
    <meta name="title" content={fullTitle} />
    <meta name="description" content={description} />
    <meta name="author" content="Balajee Ramachandran" />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />
    <meta name="generator" content="Astro" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage.toString()} />
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:locale" content="en_US" />
    {article && article.publishedTime && (
      <meta property="article:published_time" content={article.publishedTime} />
    )}
    {article && article.tags && (
      <meta property="article:tag" content={article.tags.join(",")} />
    )}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.toString()} />

    <!-- Favicon -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/favicon.svg" />

    <link
      rel="preconnect"
      href="https://fonts.googleapis.com"
    />
    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin="anonymous"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Feeds -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Balajee Ramachandran"
      href="/rss.xml"
    />
    <link
      rel="alternate"
      type="application/atom+xml"
      title="Balajee Ramachandran"
      href="/feed.xml"
    />
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <span class="site-title">
          <a href="/">Balajee Ramachandran</a>
        </span>
        <nav class="site-nav">
          <a href="/">Blog</a>
          <a href="/about">About</a>
          <a href="/resume">Resume</a>
        </nav>
      </div>
    </header>

    <main class="container">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        &copy; {new Date().getFullYear()} Balajee Ramachandran
      </div>
    </footer>
  </body>
</html>